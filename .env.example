# --- Мозг фабрики ---------------------------------------------------------
# arena-bridge = локальный ArenaAgentBridge (dev), openai = любой совместимый API, mock = офлайн
AC_PROVIDER=mock
AC_BASE_URL=http://127.0.0.1:8000/v1
AC_MODEL=arena-agent
AC_API_KEY=

# --- ArenaAgentBridge (запускается отдельно, см. docs/09) ------------------
AAB_HOST=127.0.0.1
AAB_PORT=8000
AAB_DEFAULT_MODE=agent
AAB_REQUEST_TIMEOUT=300
AAB_QUEUE_MAX_SIZE=64
AAB_SANITIZE_MODE=redact
AAB_REQUIRE_API_KEY=0
AAB_MOCK_BROWSER=0
